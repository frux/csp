{
  "name": "csp",
  "private": true,
  "workspaces": [
    "./packages/*"
  ],
  "scripts": {
    "clean": "rm -rf ./packages/*/dist ./packages/*/tsconfig.tsbuildinfo",
    "build": "npm run build --workspace csp-header && npm run build --workspace express-csp-header",
    "lint": "npm run lint --workspaces",
    "test": "npm run build && npm run test --workspaces"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "26.0.21",
    "@types/node": "^22.8.6",
    "eslint": "^9.14.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsup": "^8.5.1",
    "typescript": "^5.6.3"
  }
}
